<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Movie, episode and IPTV URLs come from the catalogue/playlist and may use
         HTTP on arbitrary media hosts (including redirects and HLS segments).
         Network Security Config cannot whitelist hosts supplied at runtime.
         HTTPS is still used whenever the source supplies an HTTPS URL. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
